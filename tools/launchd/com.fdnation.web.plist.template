<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
 "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!--
    FD nation web front door template. Do NOT copy this file directly:
    tools/install_launchd.py renders @REPO_ROOT@ to the actual repo location
    and installs the result to ~/Library/LaunchAgents.

    nfl-webd (Rust/axum, the jra-van-re jv-webd method) binds 127.0.0.1:5000:
    ALL pages native — the fantasy pages (/team, /league, /cron, pins) from
    web/templates + local artifacts, and the prediction-engine analytics
    from data/web/*.json (built OFFLINE by com.fdnation.predreport; the
    Flask backend and its reverse proxy are gone). Public exposure, when
    wanted, goes through the com.fdnation.cloudflared quick tunnel, which
    still points at 127.0.0.1:5000.

    Build the binary first: the rust/ crate, release profile.
  -->
  <key>Label</key><string>com.fdnation.web</string>
  <key>ProgramArguments</key>
  <array>
    <string>@REPO_ROOT@/rust/target/release/nfl-webd</string>
  </array>
  <key>WorkingDirectory</key><string>@REPO_ROOT@</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>5</integer>
  <key>StandardOutPath</key><string>@REPO_ROOT@/logs/web.log</string>
  <key>StandardErrorPath</key><string>@REPO_ROOT@/logs/web.log</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>NFL_WEBD_BIND</key><string>127.0.0.1:5000</string>
    <key>NFL_WEBD_ROOT</key><string>@REPO_ROOT@</string>
    <key>RUST_LOG</key><string>info</string>
  </dict>
</dict>
</plist>
